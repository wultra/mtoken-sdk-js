    <dependency id="cordova-powerauth-mobile-sdk" version="5.0.0" url="https://github.com/wultra/react-native-powerauth-mobile-sdk/releases/download/5.0.0-beta-1/cordova-powerauth-mobile-sdk-5.0.0.tgz" />
    <dependency id="cordova-powerauth-networking" version="0.0.1-dev" />
    <engines>
        <engine name="cordova" version=">=12.0.0"/>
        <engine name="cordova-android" version=">=12.0.0" />
