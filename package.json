{
  "name": "mtoken-sdk-js-monorepo",
  "version": "3.0.0",
  "description": "PowerAuth based Mobile Token SDK for React Native",
  "private": true,
  "type": "module",
  "homepage": "https://www.wultra.com/mobile-security-suite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wultra/mtoken-sdk-js.git"
  },
  "author": "Wultra <support@wultra.com> (https://wultra.com)",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.3.1+sha512.af78262d7d125afbfeed740602ace8c5e4405cd7f4735c08feb327286b2fdb2390fbca01589bfd1f50b1240548b74806767f5a063c94b67e431aabd0d86f7774",
  "workspaces": [
    "packages/*",
    "exampleReactNative",
    "exampleCordova"
  ],
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:rn": "node scripts/build.mjs rn",
    "build:cdv": "node scripts/build.mjs cordova",
    "packReactNative": "node scripts/build.mjs rn --pack && node scripts/verify-packages.mjs rn",
    "packCordova": "node scripts/build.mjs cordova --pack && node scripts/verify-packages.mjs cordova",
    "packAll": "node scripts/build.mjs all --pack && node scripts/verify-packages.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.json",
    "typecheck:example": "yarn workspace exampleReactNative typecheck",
    "typecheck": "yarn typecheck:sdk && yarn typecheck:example",
    "startReact": "yarn workspace exampleReactNative start",
    "runReactIos": "yarn workspace exampleReactNative ios",
    "runReactAndroid": "yarn workspace exampleReactNative android",
    "runCordovaIos": "yarn workspace com.wultra.mtokentest ios",
    "runCordovaAndroid": "yarn workspace com.wultra.mtokentest android"
  },
  "resolutions": {
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/react": "^19.2.0",
    "buffer": "^6.0.3",
    "cordova-powerauth-mobile-sdk": "https://github.com/wultra/react-native-powerauth-mobile-sdk/releases/download/5.0.0-beta-1/cordova-powerauth-mobile-sdk-5.0.0.tgz",
    "cordova-powerauth-networking": "https://github.com/wultra/networking-js/releases/download/2.0.0-beta-1/cordova-powerauth-networking-v2.0.0.tgz",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-powerauth-mobile-sdk": "https://github.com/wultra/react-native-powerauth-mobile-sdk/releases/download/5.0.0-beta-1/react-native-powerauth-mobile-sdk-5.0.0.tgz",
    "react-native-powerauth-networking": "https://github.com/wultra/networking-js/releases/download/2.0.0-beta-1/react-native-powerauth-networking-v2.0.0.tgz",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.2.2"
  }
}
