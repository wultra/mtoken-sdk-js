{
  "name": "com.wultra.mtokentest",
  "displayName": "MtokenTest",
  "version": "1.0.0",
  "description": "A sample Cordova application that runs Mobile Token Tests.",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "buildIos": "node scripts/build.mjs ios && cordova build ios",
    "buildAndroid": "node scripts/build.mjs android && cordova build android",
    "ios": "node scripts/build.mjs ios && cordova run ios",
    "android": "node scripts/build.mjs android && cordova run android",
    "setup": "node scripts/add-platforms.mjs ios android && yarn installPlugin",
    "installPlugin": "yarn build:cdv && node scripts/install-plugins.mjs",
    "freshIos": "yarn installPlugin && yarn ios",
    "freshAndroid": "yarn installPlugin && yarn android"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "buffer": "^6.0.3",
    "cordova": "^13.0.0",
    "cordova-android": "^13.0.0",
    "cordova-ios": "^7.1.1",
    "cordova-mtoken-sdk": "workspace:*",
    "cordova-powerauth-mobile-sdk": "https://github.com/wultra/react-native-powerauth-mobile-sdk/releases/download/5.0.0-beta-1/cordova-powerauth-mobile-sdk-5.0.0.tgz",
    "cordova-powerauth-networking": "https://github.com/wultra/networking-js/releases/download/2.0.0-beta-1/cordova-powerauth-networking-v2.0.0.tgz",
    "esbuild": "^0.23.1"
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "cordova-powerauth-mobile-sdk": {},
      "cordova-powerauth-networking": {},
      "cordova-mtoken-sdk": {}
    }
  }
}
