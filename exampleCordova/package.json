{
  "name": "com.wultra.mtokentest",
  "displayName": "MtokenTest",
  "version": "1.0.0",
  "description": "A sample Cordova application that runs Mobile Token Tests.",
  "main": "index.js",
  "scripts": {
    "build": "node ../scripts/build-cordova-example.mjs",
    "buildIos": "node ../scripts/build-cordova-example.mjs ios && cordova build ios",
    "buildAndroid": "node ../scripts/build-cordova-example.mjs android && cordova build android",
    "ios": "node ../scripts/build-cordova-example.mjs ios && cordova run ios",
    "android": "node ../scripts/build-cordova-example.mjs android && cordova run android",
    "setup": "node ../scripts/add-cordova-platforms.mjs ios android && yarn installPlugin",
    "rebuildPlugin": "yarn workspace cordova-mtoken-sdk build",
    "installPlugin": "yarn rebuildPlugin && node ../scripts/install-cordova-plugins.mjs",
    "reinstallPlugin": "yarn installPlugin",
    "freshIos": "yarn reinstallPlugin && yarn ios",
    "freshAndroid": "yarn reinstallPlugin && yarn android"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "buffer": "^6.0.3",
    "chalk": "^4.1.2",
    "cordova": "^13.0.0",
    "cordova-android": "^13.0.0",
    "cordova-ios": "^7.1.1",
    "cordova-mtoken-sdk": "workspace:*",
    "cordova-powerauth-mobile-sdk": "https://github.com/wultra/react-native-powerauth-mobile-sdk/releases/download/5.0.0-beta-1/cordova-powerauth-mobile-sdk-5.0.0.tgz",
    "cordova-powerauth-networking": "file:../../networking-js/packages/lib-cordova/cordova-powerauth-networking-v0.0.1-dev.tgz",
    "dotenv": "^16.4.5",
    "esbuild": "^0.23.1"
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "cordova-powerauth-mobile-sdk": {},
      "cordova-powerauth-networking": {},
      "cordova-mtoken-sdk": {}
    }
  }
}
